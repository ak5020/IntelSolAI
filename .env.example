# ---------------------------------------------------------------------------
# Contact form (app/api/contact/route.ts). Copy to .env.local and fill in.
# .env.local is gitignored — real values must never be committed.
# ---------------------------------------------------------------------------

# Where enquiries are delivered. Server-side only; never exposed to the client.
CONTACT_TO_EMAIL=

# The address enquiries are sent FROM. See the provider notes below.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Mail provider — pick ONE. See HANDOFF.md §1.1.
#
# If SMTP_HOST + SMTP_USER + SMTP_PASS are all set, SMTP is used.
# Otherwise RESEND_API_KEY is used. Switching provider is an env change only.
# ---------------------------------------------------------------------------

# --- Option A: SMTP (Nodemailer). Works immediately, no DNS setup. ----------
# For Gmail:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Use the 16-character App Password below — NOT your Google password
#
# Gmail rewrites the From header to the authenticated account, so set
# CONTACT_FROM_EMAIL to that same Gmail address unless you have added a
# verified "Send mail as" alias in Gmail settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Option B: Resend. Faster and better deliverability, needs a verified
#     domain (publish the SPF, DKIM and DMARC records it gives you). ---------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Public values (safe to expose in the browser)
# ---------------------------------------------------------------------------

# Reply-to address shown on the page.
NEXT_PUBLIC_CONTACT_EMAIL=intelagen01@gmail.com

# Canonical site origin, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://intelsolai.com

# Google Analytics 4 measurement ID. Public — appears in every page's HTML,
# so there is nothing to protect by keeping it out of source control.
NEXT_PUBLIC_GA_ID=G-MQHJ4LMT0F
