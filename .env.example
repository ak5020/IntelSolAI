# ---------------------------------------------------------------------------
# Contact form (app/api/contact/route.ts). Copy to .env.local and fill in.
# .env.local is gitignored — real values must never be committed.
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Server-side only; never exposed to the client.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend (SPF + DKIM + DMARC).
# Until intelsolai.com is verified, use onboarding@resend.dev for local testing.
CONTACT_FROM_EMAIL=website@intelsolai.com

# Public reply-to address shown on the page (safe to expose).
NEXT_PUBLIC_CONTACT_EMAIL=hello@intelsolai.com

# Canonical site origin, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://intelsolai.com
